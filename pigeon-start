#!/bin/sh
# A job Container's entrypoint: runs main's newest pigeon build when the Worker names one and
# its SHA-256 matches, else the image's own; see
# .claude/decisions/2026-11-07-development-job-images-on-cloudflare.md §3. A named
# judge, pigeon-eviction, that matches is exported as PIGEON_EVICTION, for the bound job; see
# .claude/decisions/2026-11-10-development-factory-crates-functional-core.md §2. A named test
# map that matches is exported as PIGEON_TEST_MAP, per that ADR's 2026-11-11 amendment.
set -u
baked=/usr/local/bin/pigeon
dir="${TMPDIR:-/tmp}"

# access: the builds token's headers, as curl config on stdin, never in argv.
access() {
  printf 'header = "CF-Access-Client-Id: %s"\nheader = "CF-Access-Client-Secret: %s"\n' \
    "${PIGEON_BUILD_ACCESS_ID:-}" "${PIGEON_BUILD_ACCESS_SECRET:-}"
}

# mcp HOST SESSION TOOL ARGS: one tools/call on HOST's /mcp, with the builds token.
mcp() {
  access | curl -fsS --retry 3 --max-time 120 --config - -X POST \
    -H 'content-type: application/json' -H 'accept: application/json' -H "mcp-session-id: $2" \
    --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$3\",\"arguments\":$4}}" \
    "https://$1/mcp"
}

# mcp_read URL SHA256 FILE: reads URL, https://<host>/builds/<sha>/<name>, through `build.read` on
# <host>'s /mcp in pieces, with the builds token; succeeds only when the file's SHA-256 matches;
# see .claude/decisions/2026-11-18-security-users-levels-capability-grants.md, its group E.
mcp_read() {
  rest=${1#https://}
  host=${rest%%/*}
  path=${rest#*/}
  case "$path" in
    builds/*/*) ;;
    *) return 1 ;;
  esac
  path=${path#builds/}
  sha=${path%%/*}
  name=${path#*/}
  session=$(access | curl -fsS --max-time 30 --config - -o /dev/null -D - -X POST \
      -H 'content-type: application/json' -H 'accept: application/json' \
      --data '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"pigeon-start","version":"1"}}}' \
      "https://$host/mcp" 2>/dev/null | tr -d '\r' |
    sed -n 's/^[Mm][Cc][Pp]-[Ss][Ee][Ss][Ss][Ii][Oo][Nn]-[Ii][Dd]: *//p' | tail -n 1)
  : >"$3" || return 1
  offset=0
  while [ -n "$session" ] && [ -n "$offset" ]; do
    if ! mcp "$host" "$session" build_read "{\"sha\":\"$sha\",\"name\":\"$name\",\"offset\":\"$offset\"}" >"$3.part"; then
      offset=
      break
    fi
    sed -n 's/.*"data":"\([A-Za-z0-9+\/=]*\)".*/\1/p' "$3.part" | base64 -d >>"$3" || break
    offset=$(sed -n 's/.*"next":\([0-9]*\).*/\1/p' "$3.part")
  done
  rm -f "$3.part"
  if [ -n "$session" ] && printf '%s  %s\n' "$2" "$3" | sha256sum -c - >/dev/null 2>&1; then
    chmod +x "$3"
    return 0
  fi
  rm -f "$3"
  return 1
}

# fetch URL SHA256 FILE: `build.read`, else a GET of URL itself, until `/builds/` goes (E3).
fetch() {
  mcp_read "$1" "$2" "$3" && return 0
  if access | curl -fsSL --retry 3 --max-time 120 --config - -o "$3" "$1" \
    && printf '%s  %s\n' "$2" "$3" | sha256sum -c - >/dev/null 2>&1; then
    chmod +x "$3"
    return 0
  fi
  rm -f "$3"
  return 1
}

unset PIGEON_EVICTION
judge_url="${PIGEON_EVICTION_URL:-}"
judge_sha="${PIGEON_EVICTION_SHA256:-}"
if [ -n "$judge_url" ] && [ -n "$judge_sha" ]; then
  if fetch "$judge_url" "$judge_sha" "$dir/pigeon-eviction"; then
    export PIGEON_EVICTION="$dir/pigeon-eviction"
    echo "pigeon-start: judging with judge build $judge_sha" >&2
  else
    echo "pigeon-start: the judge build at $judge_url is missing or its checksum differs; judging with the linked library" >&2
  fi
fi

unset PIGEON_TEST_MAP
if [ -n "${PIGEON_TEST_MAP_URL:-}" ] && [ -n "${PIGEON_TEST_MAP_SHA256:-}" ]; then
  if fetch "$PIGEON_TEST_MAP_URL" "$PIGEON_TEST_MAP_SHA256" "$dir/tests.json"; then
    export PIGEON_TEST_MAP="$dir/tests.json"
    echo "pigeon-start: test map $PIGEON_TEST_MAP_SHA256" >&2
  else
    echo "pigeon-start: the test map at $PIGEON_TEST_MAP_URL is missing or its checksum differs; selecting by crate" >&2
  fi
fi

if [ -n "${PIGEON_BUILD_URL:-}" ] && [ -n "${PIGEON_BUILD_SHA256:-}" ]; then
  if fetch "$PIGEON_BUILD_URL" "$PIGEON_BUILD_SHA256" "$dir/pigeon-build"; then
    unset PIGEON_BUILD_ACCESS_ID PIGEON_BUILD_ACCESS_SECRET
    echo "pigeon-start: running build $PIGEON_BUILD_SHA256" >&2
    exec "$dir/pigeon-build" "$@"
  fi
  echo "pigeon-start: the build at $PIGEON_BUILD_URL is missing or its checksum differs; running the image's pigeon" >&2
else
  echo "pigeon-start: no build named; running the image's pigeon" >&2
fi
unset PIGEON_BUILD_ACCESS_ID PIGEON_BUILD_ACCESS_SECRET
exec "$baked" "$@"
