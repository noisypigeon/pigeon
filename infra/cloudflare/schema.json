{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infra/cloudflare",
  "description": "The Cloudflare provisioner unit; see .claude/decisions/2026-11-02-runtime-cloudflare-provisioner-unit.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["zones", "rotation", "tokens"],
  "x-cobot": {
    "version": "0.1.0",
    "secrets": ["account_id", "provisioner_token"],
    "providers": {
      "cloudflare": { "api_token": "$secret.provisioner_token" }
    },
    "singletons": {
      "permission_groups": {
        "module": "permission-groups",
        "inputs": { "account_id": "$secret.account_id" }
      }
    }
  },
  "properties": {
    "zones": {
      "description": "Existing zones this account may use; looked up, never created.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "uniqueItems": true,
      "x-cobot": {
        "module": "zone",
        "for_each": "$item",
        "inputs": { "name": "$item", "account_id": "$secret.account_id" }
      }
    },
    "rotation": {
      "description": "How long each token generation lasts, and how long it overlaps its successor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["period_days", "overlap_days"],
      "properties": {
        "period_days": { "type": "integer", "minimum": 1 },
        "overlap_days": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "description": "Account tokens to mint, one instance per generation.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "capabilities"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["permission"],
              "properties": {
                "permission": { "type": "string", "minLength": 1 },
                "zones": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "account": { "const": true }
              },
              "oneOf": [{ "required": ["zones"] }, { "required": ["account"] }]
            }
          }
        }
      },
      "x-cobot": {
        "module": "api-token",
        "for_each": "$item.name",
        "rotate": {
          "period_days": "$config.rotation.period_days",
          "overlap_days": "$config.rotation.overlap_days"
        },
        "inputs": {
          "name": "$item.name",
          "capabilities": "$item.capabilities",
          "zone_ids": "$module.zones[*].id",
          "groups": "$module.permission_groups.groups",
          "account_id": "$secret.account_id",
          "not_before": "$generation.not_before",
          "expires_on": "$generation.expires_on"
        }
      }
    }
  }
}
