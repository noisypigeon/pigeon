{
  "permissions": {
    "allow": [
      "mcp__pigeon__change_propose",
      "mcp__pigeon__change_authorize",
      "mcp__pigeon__change_approve",
      "mcp__pigeon__change_merge",
      "mcp__pigeon__change_pushed",
      "mcp__pigeon__change_status",
      "mcp__pigeon__change_list",
      "mcp__pigeon__change_scope",
      "mcp__pigeon__change_note",
      "mcp__pigeon__change_handoff",
      "mcp__pigeon__change_yield",
      "mcp__pigeon__change_evictable",
      "mcp__pigeon__ci_rerun",
      "mcp__pigeon__approval_wait",
      "mcp__pigeon__brief_create",
      "mcp__pigeon__brief_amend",
      "mcp__pigeon__brief_review",
      "mcp__pigeon__brief_escalate",
      "mcp__pigeon__brief_show",
      "mcp__pigeon__brief_list",
      "mcp__pigeon__task_claim",
      "mcp__pigeon__task_done",
      "mcp__pigeon__task_list",
      "mcp__pigeon__task_wait",
      "mcp__pigeon__session_start",
      "mcp__pigeon__session_status",
      "mcp__pigeon__session_end",
      "mcp__pigeon__events_wait",
      "mcp__pigeon__mandate_propose",
      "mcp__pigeon__mandate_status",
      "mcp__pigeon__mandate_end",
      "mcp__pigeon__deploy_status",
      "mcp__pigeon__digest_show",
      "mcp__pigeon__instance_show",
      "mcp__pigeon__architecture_describe",
      "mcp__pigeon__policy_check",
      "mcp__pigeon__platform_status",
      "mcp__pigeon__ios_status",
      "mcp__pigeon__infra_validate",
      "mcp__pigeon__sites_build"
    ],
    "ask": [
      "mcp__pigeon__change_close",
      "mcp__pigeon__change_pin",
      "mcp__pigeon__grant_revoke",
      "mcp__pigeon__grant_rotate",
      "mcp__pigeon__grant_request",
      "mcp__pigeon__git_tokens",
      "mcp__pigeon__platform_apply",
      "mcp__pigeon__infra_apply",
      "mcp__pigeon__deploy_retry",
      "mcp__pigeon__sites_publish",
      "mcp__pigeon__ios_release"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tooling/session/session.sh\" brief",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tooling/session/session.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$CLAUDE_PROJECT_DIR/tooling/session/session.sh\" statusline"
  }
}
