{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cloudflare/static-site",
  "description": "A static site on R2, served at the hosts it claims in its zone; see .claude/decisions/2026-11-05-runtime-instance-config-kind-units.md §2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zone",
    "hosts",
    "template",
    "site"
  ],
  "properties": {
    "zone": {
      "description": "The zone it serves, a cloudflare/zone unit's name.",
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
    },
    "hosts": {
      "description": "The names it claims, relative to the zone; none when a platform serves it (served_by).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "served_by": {
      "description": "A pigeon/platform unit that serves it at a path, with no host of its own; see .claude/decisions/2026-11-11-runtime-docs-under-platform-passkey.md §4.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "path"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-z0-9-]+$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "description": "The template in src/site-templates/<name>/.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "description": "A released X.Y.Z, or tree: src/site-templates/<name>/ at the published commit, for a template in the instance's own tree.",
          "type": "string",
          "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+|tree)$"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "content": {
      "description": "Its posts/, pages/ and assets/, relative to the instance.",
      "type": "string"
    },
    "storage_class": {
      "enum": [
        "Standard",
        "InfrequentAccess"
      ]
    },
    "site": {
      "description": "Its settings, validated against the pinned template's schema.json.",
      "type": "object"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^(@|(\\*\\.)?[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*)$"
    }
  },
  "x-cobot": {
    "version": "0.1.0",
    "providers": {
      "cloudflare": {
        "api_token": "$credential.cloudflare.api_token"
      }
    },
    "credentials": {
      "cloudflare": {
        "provider": "cloudflare",
        "capabilities": [
          "r2.write"
        ],
        "scope": "account"
      },
      "cloudflare_zone": {
        "provider": "cloudflare",
        "capabilities": [
          "zone.read",
          "dns.write"
        ],
        "scope": "zone",
        "target": "$config.zone"
      }
    },
    "singletons": {
      "account": {
        "module": "account",
        "inputs": {}
      },
      "zone": {
        "module": "zone",
        "inputs": {
          "name": "$config.zone",
          "account_id": "$module.account.id"
        }
      }
    },
    "derived": {
      "bucket": {
        "expand": "site-bucket",
        "module": "r2-bucket",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.name",
          "storage_class": "$item.storage_class"
        }
      },
      "domains": {
        "expand": "site-domains",
        "module": "r2-custom-domain",
        "inputs": {
          "account_id": "$module.account.id",
          "bucket_name": "$module.bucket[$item.bucket].name",
          "domain": "$item.domain",
          "zone_id": "$module.zone.id"
        }
      }
    }
  }
}
