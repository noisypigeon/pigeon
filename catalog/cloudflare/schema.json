{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infra/cloudflare",
  "description": "The Cloudflare provisioner unit; see .claude/decisions/2026-11-02-runtime-cloudflare-provisioner-unit.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["zones", "rotation", "tokens"],
  "x-cobot": {
    "version": "0.1.10",
    "secrets": ["account_id", "provisioner_token"],
    "providers": {
      "cloudflare": { "api_token": "$secret.provisioner_token" }
    },
    "apex": {
      "secrets": "referenced",
      "handoff": "zone-token",
      "providers": {
        "cloudflare": {
          "per_zone": true,
          "api_token": "$handoff.api_token"
        }
      },
      "derived": {
        "dns_records": {
          "expand": "zone-records",
          "module": "dns-record",
          "inputs": {
            "zone_id": "$handoff.zone_id",
            "name": "$item.name",
            "type": "$item.type",
            "content": "$item.content",
            "ttl": "$item.ttl",
            "priority": "$item.priority",
            "proxied": "$item.proxied"
          }
        },
        "zone_rulesets": {
          "expand": "zone-rulesets",
          "module": "ruleset",
          "inputs": {
            "zone_id": "$handoff.zone_id",
            "name": "$item.name",
            "phase": "$item.phase",
            "rules": "$item.rules"
          }
        }
      }
    },
    "workload": {
      "handoff": "workload-token",
      "providers": {
        "cloudflare": { "api_token": "$handoff.api_token" }
      },
      "derived": {
        "bucket": {
          "expand": "site-bucket",
          "module": "r2-bucket",
          "inputs": {
            "account_id": "$handoff.account_id",
            "name": "$item.name",
            "storage_class": "$item.storage_class"
          }
        },
        "domains": {
          "expand": "site-domains",
          "module": "r2-custom-domain",
          "inputs": {
            "account_id": "$handoff.account_id",
            "bucket_name": "$module.bucket[$item.bucket].name",
            "domain": "$item.domain",
            "zone_id": "$handoff.zone_id"
          }
        }
      }
    },
    "outputs": {
      "zone_ids": "$module.zones[*].id",
      "tokens": "$module.tokens[*].value",
      "token_ids": "$module.tokens[*].id",
      "account_id": "$secret.account_id"
    },
    "singletons": {
      "permission_groups": {
        "module": "permission-groups",
        "inputs": { "account_id": "$secret.account_id" }
      }
    }
  },
  "properties": {
    "zones": {
      "description": "Existing zones this account may use; looked up, never created.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "uniqueItems": true,
      "x-cobot": {
        "module": "zone",
        "for_each": "$item",
        "inputs": { "name": "$item", "account_id": "$secret.account_id" }
      }
    },
    "rotation": {
      "description": "How long each token generation lasts, and how long it overlaps its successor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["period_days", "overlap_days"],
      "properties": {
        "period_days": { "type": "integer", "minimum": 1 },
        "overlap_days": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "description": "Account tokens to mint, one instance per generation.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "capabilities"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["permission"],
              "properties": {
                "permission": { "type": "string", "minLength": 1 },
                "zones": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "account": { "const": true }
              },
              "oneOf": [{ "required": ["zones"] }, { "required": ["account"] }]
            }
          }
        }
      },
      "x-cobot": {
        "module": "api-token",
        "for_each": "$item.name",
        "rotate": {
          "period_days": "$config.rotation.period_days",
          "overlap_days": "$config.rotation.overlap_days"
        },
        "inputs": {
          "name": "$item.name",
          "capabilities": "$item.capabilities",
          "zone_ids": "$module.zones[*].id",
          "groups": "$module.permission_groups.groups",
          "account_id": "$secret.account_id",
          "not_before": "$generation.not_before",
          "expires_on": "$generation.expires_on"
        }
      }
    }
  },
  "$defs": {
    "apex": {
      "description": "An apex as composed: workloads/<zone>/apex/config.yaml under zones.<zone>; see .claude/decisions/2026-11-02-runtime-workloads-zone-apex.md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones"
      ],
      "properties": {
        "zones": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/zone_apex"
          }
        }
      }
    },
    "zone_apex": {
      "description": "One zone's apex: its global config and DNS.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "services",
        "records"
      ],
      "properties": {
        "apex": {
          "description": "The workload served at @ and www.",
          "$ref": "#/$defs/workload_name"
        },
        "hosts": {
          "description": "A workload's names, relative to the zone, replacing its default.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/workload_name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "services": {
          "description": "Presets by name, each catalog/cloudflare/presets/<name>.yaml; cobot checks their inputs.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "records": {
          "description": "Explicit records by key; a preset or host record's key overrides it field by field, and false drops it.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/record"
              }
            ]
          }
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "workload_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": {
        "const": "apex"
      }
    },
    "workload": {
      "description": "A workload under workloads/<zone>/; see .claude/decisions/2026-11-03-runtime-cloudflare-static-sites-r2.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["static_site"],
      "properties": {
        "static_site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "site"],
          "properties": {
            "template": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
                "features": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
                }
              }
            },
            "storage_class": { "enum": ["Standard", "InfrequentAccess"] },
            "site": {
              "description": "The site's settings, validated against the pinned template's schema.json; see .claude/decisions/2026-11-03-runtime-static-site-config-contract.md.",
              "type": "object"
            }
          }
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^(@|(\\*\\.)?[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*)$"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret"
      ],
      "properties": {
        "secret": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "MX",
            "TXT"
          ]
        },
        "content": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/secret"
            }
          ]
        },
        "ttl": {
          "type": "integer",
          "anyOf": [
            {
              "const": 1
            },
            {
              "minimum": 60,
              "maximum": 86400
            }
          ]
        },
        "priority": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535
        },
        "proxied": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "proxied": {
          "type": "boolean"
        }
      }
    }
  }
}
