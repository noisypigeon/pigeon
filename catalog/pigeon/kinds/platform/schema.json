{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pigeon/platform",
  "description": "One stack of the platform: every resource that holds its state or takes its traffic, each named explicitly; see .claude/decisions/2026-11-08-runtime-blue-green-self-standup.md, step 3's design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker",
    "hostname",
    "domains",
    "instance",
    "change_floor",
    "database",
    "buckets",
    "queue",
    "access",
    "service_tokens"
  ],
  "properties": {
    "worker": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The control plane Worker's name."
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
      },
      "description": "The hostnames the stack serves as custom domains, which Access protects: the live domain and its own <color> host."
    },
    "hostname": {
      "type": "string",
      "description": "The host the stack serves, and Access protects.",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The instance it serves (INSTANCE_NAME)."
    },
    "change_floor": {
      "type": "integer",
      "minimum": 1,
      "description": "The first change number it assigns."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "description": "The stack's D1 database."
    },
    "buckets": {
      "description": "Private R2 buckets, each named <name>-<random suffix>.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 56
          }
        }
      },
      "x-cobot": {
        "module": "cloudflare/r2-bucket",
        "for_each": "$item.name",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.name",
          "suffix": "$module.bucket_suffixes[$item.name].result"
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "description": "The queue Artifacts push events arrive on."
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "owners_policy"
      ],
      "description": "The Access application on the stack's Worker, and its owners' policy: the account's Cloudflare members, so no address is committed.",
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The Access application's name."
        },
        "owners_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The policy that lets the account's members in."
        }
      }
    },
    "service_tokens": {
      "type": "array",
      "uniqueItems": true,
      "description": "The stack's service tokens, each with its own Service Auth policy: the agent's, the deployer's and the builds'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "policy",
          "secret_version",
          "previous_secret_expires"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The token's name."
          },
          "policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Its Service Auth policy's name."
          },
          "secret_version": {
            "type": "integer",
            "minimum": 1,
            "description": "The live secret's version, as Cloudflare holds it; raising it rotates the secret."
          },
          "previous_secret_expires": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "When the secret before the live one stops being accepted, as Cloudflare holds it (RFC 3339, UTC)."
          }
        }
      },
      "x-cobot": {
        "module": "cloudflare/access-service-token",
        "for_each": "$item.name",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.name",
          "secret_version": "$item.secret_version",
          "previous_secret_expires": "$item.previous_secret_expires"
        }
      }
    },
    "public_paths": {
      "type": "array",
      "uniqueItems": true,
      "description": "Paths reached without an Access login, each its own application with a bypass policy; its route authenticates the caller itself. See .claude/decisions/2026-11-08-runtime-blue-green-self-standup.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "paths"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The application's and its policy's name."
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "The path on each of the stack's domains, as hostname and path.",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+/[A-Za-z0-9/._-]+$"
            }
          }
        }
      }
    }
  },
  "x-cobot": {
    "version": "0.4.0",
    "local": true,
    "secrets": [],
    "providers": {
      "cloudflare": {}
    },
    "singletons": {
      "account": {
        "module": "cloudflare/account",
        "inputs": {}
      },
      "d1": {
        "module": "cloudflare/d1-database",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.database.name"
        }
      },
      "queue": {
        "module": "cloudflare/queue",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.queue.name"
        }
      },
      "secrets_store": {
        "module": "cloudflare/secrets-store",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.worker"
        }
      },
      "owners": {
        "module": "cloudflare/access-policy",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.access.owners_policy",
          "account_members": true
        }
      },
      "application": {
        "module": "cloudflare/access-application",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.access.application",
          "policy_ids": [
            "$module.owners.id"
          ],
          "policy_id_map": "$module.token_policies[*].id",
          "worker_id": "$module.worker.id",
          "hostnames": "$config.domains"
        }
      },
      "worker": {
        "module": "cloudflare/worker",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$config.worker"
        }
      }
    },
    "each": {
      "bucket_suffixes": {
        "module": "agnostic/random-string",
        "over": "buckets",
        "for_each": "$item.name",
        "inputs": {}
      },
      "token_policies": {
        "module": "cloudflare/access-policy",
        "over": "service_tokens",
        "for_each": "$item.name",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.policy",
          "service_token_id": "$module.service_tokens[$item.name].id"
        }
      },
      "public_policies": {
        "module": "cloudflare/access-policy",
        "over": "public_paths",
        "for_each": "$item.name",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.name",
          "bypass": true
        }
      },
      "public_applications": {
        "module": "cloudflare/access-application",
        "over": "public_paths",
        "for_each": "$item.name",
        "inputs": {
          "account_id": "$module.account.id",
          "name": "$item.name",
          "policy_ids": [
            "$module.public_policies[$item.name].id"
          ],
          "hostnames": "$item.paths"
        }
      }
    },
    "outputs": {
      "account_id": "$module.account.id",
      "database_id": "$module.d1.id",
      "bucket_names": "$module.buckets[*].name",
      "queue_name": "$module.queue.name",
      "access_aud": "$module.application.aud",
      "service_token_ids": "$module.service_tokens[*].client_id",
      "secrets_store_id": "$module.secrets_store.id"
    }
  }
}
